---
import '../../styles/main.css'
import XahauLearn from '../../components/XahauLearn.astro'
import learnData from '../../data/learn.json'
import BaseLayout from '../../layouts/BaseLayout.astro'
import generateStaticPaths from '../../utils/generateStaticPaths'

export function getStaticPaths() {
  return generateStaticPaths()
}

const { locale } = Astro.props
const { title, description } = learnData.pageMeta[locale]
const _frontmatter = { title, description }
---

<BaseLayout frontmatter={_frontmatter}>
  <div class="page-content flex-1 container mx-auto max-w-7xl p-6">
    <XahauLearn />
  </div>
</BaseLayout>

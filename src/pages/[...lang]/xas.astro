---
import '../../styles/main.css'
import XahauStandards from '../../components/XahauStandards.astro'
import xasData from '../../data/xas.json'
import { defaultLocale } from '../../i18n/locales'
import BaseLayout from '../../layouts/BaseLayout.astro'
import generateStaticPaths from '../../utils/generateStaticPaths'

export function getStaticPaths() {
  return generateStaticPaths()
}

const { locale } = Astro.props
// Page content is English-only for now; every locale falls back to it rather
// than 404ing, so the nav link works on all four sites.
const { title, description } =
  xasData.pageMeta[locale as keyof typeof xasData.pageMeta] ??
  xasData.pageMeta[defaultLocale]
const _frontmatter = { title, description }
---

<BaseLayout frontmatter={_frontmatter}>
  <div class="page-content flex-1 container mx-auto max-w-7xl p-6">
    <XahauStandards />
  </div>
</BaseLayout>
